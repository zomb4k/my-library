 <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f4f6fa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        /* Основной контейнер — карточка страницы */
        .library-app {
            max-width: 1100px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 32px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            padding: 2rem 2rem 2.5rem 2rem;
        }

        /* Шапка */
        .header {
            margin-bottom: 2rem;
        }

        .header h1 {
            font-size: 2.2rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: #0b1b2f;
            line-height: 1.2;
        }

        .header h1 span {
            display: block;
            font-size: 1rem;
            font-weight: 400;
            color: #5e6f88;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            margin-top: 0.2rem;
        }

        /* Навигационные вкладки (Каталог, Поиск, Мои книги) */
        .nav-tabs {
            display: flex;
            gap: 0.5rem;
            margin: 1.5rem 0 1.2rem 0;
            border-bottom: 1.5px solid #e6edf4;
            padding-bottom: 0.5rem;
        }

        .nav-item {
            font-size: 1.1rem;
            font-weight: 500;
            padding: 0.4rem 1rem;
            color: #4b5e77;
            background: transparent;
            border: none;
            border-radius: 40px;
            cursor: default;
            transition: all 0.1s;
        }

        .nav-item.active {
            background-color: #eef2f8;
            color: #0f2b45;
            font-weight: 550;
        }

        /* Строка поиска */
        .search-section {
            margin: 1.2rem 0 2rem 0;
        }

        .search-box {
            display: flex;
            align-items: center;
            background-color: #f0f4fa;
            border-radius: 60px;
            padding: 0.1rem 0.1rem 0.1rem 1.5rem;
            border: 1px solid #dae2ed;
            max-width: 450px;
        }

        .search-box input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 0.85rem 0.5rem;
            font-size: 0.98rem;
            color: #1a2b3e;
            outline: none;
        }

        .search-box input::placeholder {
            color: #8698aa;
            font-weight: 350;
            letter-spacing: -0.01em;
        }

        .search-box button {
            background-color: #1f344b;
            border: none;
            color: white;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.6rem 1.4rem;
            border-radius: 40px;
            cursor: default;
            letter-spacing: 0.01em;
            white-space: nowrap;
            border: 1px solid #1f344b;
        }

        /* Контейнер для списка книг — грид */
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.2rem;
            margin-top: 1.8rem;
        }

        /* Карточка книги */
        .book-card {
            background-color: #ffffff;
            border: 1px solid #e2eaf2;
            border-radius: 20px;
            padding: 1.3rem 1.2rem 1.2rem 1.2rem;
            transition: all 0.15s ease;
            box-shadow: 0 2px 6px rgba(0, 20, 30, 0.02);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .book-card:hover {
            border-color: #b3c9e0;
            box-shadow: 0 12px 20px -14px rgba(20, 40, 70, 0.2);
        }

        /* Статус (Выдана / Доступны и т.п.) */
        .book-status {
            display: inline-block;
            align-self: flex-start;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            padding: 0.3rem 0.9rem;
            border-radius: 30px;
            margin-bottom: 1rem;
            background-color: #f0f5fb;
            color: #1e3a5f;
            border: 1px solid transparent;
        }

        .status-borrowed {
            background-color: #fff1e5;
            color: #b05317;
            border-color: #ffdec9;
        }

        .status-available {
            background-color: #e2f0e9;
            color: #0f6e47;
            border-color: #b7e0cf;
        }

        /* Заголовок книги */
        .book-title {
            font-size: 1.3rem;
            font-weight: 600;
            line-height: 1.3;
            margin-bottom: 0.4rem;
            color: #0b1b2f;
        }

        /* Автор */
        .book-author {
            font-size: 0.95rem;
            color: #61768e;
            margin-bottom: 0.4rem;
            font-weight: 450;
        }

        /* Жанр */
        .book-genre {
            font-size: 0.85rem;
            color: #8499b2;
            background-color: #f1f5fa;
            display: inline-block;
            padding: 0.25rem 0.9rem;
            border-radius: 30px;
            margin-top: 0.3rem;
            align-self: flex-start;
        }

        /* Простой разделитель (необязательно) */
        .divider-text {
            margin: 2rem 0 0.5rem 0;
            color: #8f9fb1;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 500;
        }

        /* Кнопки и элементы интерфейса для полноты — неактивные, только стиль */
        .mock-link {
            color: #1e3a5f;
            text-decoration: none;
            cursor: default;
        }

        /* Если потребуется мелкая подпись */
        .caption-note {
            font-size: 0.7rem;
            color: #a1b4c9;
            margin-top: 1.5rem;
            border-top: 1px dashed #d9e2ec;
            padding-top: 1rem;
            text-align: center;
        }